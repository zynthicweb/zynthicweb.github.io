# ==============================================================================
# BROWSER CACHING & COMPRESSION CONFIGURATION (.htaccess)
# Zynthic Web Solutions — High Performance Web Optimization
# ==============================================================================

# 1. Enable GZIP / Deflate Compression
<IfModule mod_deflate.c>
    # Compress HTML, CSS, JavaScript, Text, XML, JSON, SVG and Fonts
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/woff font/woff2 font/ttf application/vnd.ms-fontobject
</IfModule>

# 2. Set Efficient Browser Cache Lifetimes (Expires Headers)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # CSS & JavaScript - 1 Year Cache
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Web Fonts - 1 Year Cache
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    
    # Media & Images - 1 Year Cache
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Manifest & JSON Data
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType application/json "access plus 0 seconds"
    
    # HTML - Always Revalidate
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# 3. Cache-Control Header Fallback
<IfModule mod_headers.c>
    # Static Assets (1 Year Cache)
    <FilesMatch "\.(css|js|woff2|woff|ttf|eot|jpg|jpeg|png|gif|webp|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
    
    # HTML Documents (Always Revalidate)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
